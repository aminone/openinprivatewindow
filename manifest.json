{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "mahmudian.ir",
  "homepage_url": "https://github.com/aminone/openinprivatewindow",

  "browser_specific_settings": {
    "gecko": {
      "id": "openinprivatewindow@mahmudian.ir",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "contextMenus",
    "tabs",
    "storage"
  ],

  "background": {
    "scripts": ["src/trackingParams.js", "src/background.js"]
  },

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
