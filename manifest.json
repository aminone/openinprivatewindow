{
  "manifest_version": 3,
  "name": "Open in Private Window",
  "version": "0.1.0",
  "description": "Reopen the current tab's URL in a new Private Browsing window from the tab context menu.",
  "author": "mahmudian.ir",
  "homepage_url": "https://github.com/aminone/openinprivatewindow",

  "browser_specific_settings": {
    "gecko": {
      "id": "openinprivatewindow@mahmudian.ir",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "contextMenus",
    "tabs"
  ],

  "background": {
    "scripts": ["src/background.js"]
  },

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
